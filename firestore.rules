rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'lovely.bunts@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 160)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 600)) &&
             (!('role' in data) || (data.role in ['student', 'admin'])) &&
             (!('examName' in data) || (data.examName is string && data.examName.size() <= 100)) &&
             (!('examDateMillis' in data) || (data.examDateMillis is int && data.examDateMillis >= 0)) &&
             (!('themeId' in data) || (data.themeId in ['bunts_royal_light', 'bunts_navy_dark', 'midnight_teal', 'forest_sage', 'indigo_velvet', 'warm_espresso'])) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSubject(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 80 &&
             (!('nameHi' in data) || (data.nameHi is string && data.nameHi.size() <= 80)) &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
             data.colorHex is string && data.colorHex.size() >= 1 && data.colorHex.size() <= 20 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTopic(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.subjectId) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSubtopic(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.subjectId) &&
             isValidId(data.topicId) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             (!('lastStudiedDate' in data) || (data.lastStudiedDate is string && data.lastStudiedDate.size() <= 20)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidNote(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.subjectId) &&
             isValidId(data.topicId) &&
             isValidId(data.subtopicId) &&
             data.folderName is string && data.folderName.size() <= 80 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.noteType in ['PDF', 'HTML', 'IMAGE', 'FOLDER'] &&
             (!('localFileName' in data) || (data.localFileName is string && data.localFileName.size() <= 200)) &&
             (!('htmlContent' in data) || (data.htmlContent is string && data.htmlContent.size() <= 200000)) &&
             (!('lastOpenedDate' in data) || (data.lastOpenedDate is string && data.lastOpenedDate.size() <= 20)) &&
             (!('isMockTest' in data) || data.isMockTest is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVideo(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.subjectId) &&
             isValidId(data.topicId) &&
             isValidId(data.subtopicId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.youtubeUrl is string && data.youtubeUrl.size() >= 1 && data.youtubeUrl.size() <= 500 &&
             (!('channelOrNote' in data) || (data.channelOrNote is string && data.channelOrNote.size() <= 150)) &&
             (!('lastWatchedDate' in data) || (data.lastWatchedDate is string && data.lastWatchedDate.size() <= 20)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMcq(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.subjectId) &&
             isValidId(data.topicId) &&
             isValidId(data.subtopicId) &&
             data.question is string && data.question.size() >= 1 && data.question.size() <= 500 &&
             data.options is list && data.options.size() >= 2 && data.options.size() <= 6 &&
             data.options[0] is string &&
             data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex < data.options.size() &&
             (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTestResult(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.subjectId) &&
             isValidId(data.topicId) &&
             isValidId(data.subtopicId) &&
             (!('noteId' in data) || (data.noteId is string && data.noteId.size() <= 128)) &&
             data.testTitle is string && data.testTitle.size() >= 1 && data.testTitle.size() <= 150 &&
             data.scoreObtained is number && data.scoreObtained >= 0 &&
             data.totalMarks is number && data.totalMarks >= 0 &&
             data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
             (!('totalQuestions' in data) || (data.totalQuestions is int && data.totalQuestions >= 0)) &&
             (!('attemptedCount' in data) || (data.attemptedCount is int && data.attemptedCount >= 0)) &&
             (!('correctCount' in data) || (data.correctCount is int && data.correctCount >= 0)) &&
             (!('wrongCount' in data) || (data.wrongCount is int && data.wrongCount >= 0)) &&
             (!('unattemptedCount' in data) || (data.unattemptedCount is int && data.unattemptedCount >= 0)) &&
             (!('durationSeconds' in data) || (data.durationSeconds is int && data.durationSeconds >= 0)) &&
             (!('testMode' in data) || (data.testMode in ['PRACTICE', 'EXAM'])) &&
             (!('breakdownJson' in data) || (data.breakdownJson is string && data.breakdownJson.size() <= 350000)) &&
             (!('summaryText' in data) || (data.summaryText is string && data.summaryText.size() <= 300)) &&
             data.takenDate is string && data.takenDate.size() >= 1 && data.takenDate.size() <= 20 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudyLog(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.dateKey is string && data.dateKey.size() >= 1 && data.dateKey.size() <= 20 &&
             data.entryType in ['PLANNED', 'STUDIED'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 80)) &&
             (!('subtopicId' in data) || (data.subtopicId is string && data.subtopicId.size() <= 128)) &&
             data.completed is bool &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRevisionDiary(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.dateKey is string && data.dateKey.size() >= 1 && data.dateKey.size() <= 20 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 80)) &&
             data.sourceName is string && data.sourceName.size() >= 1 && data.sourceName.size() <= 150 &&
             data.content is string && data.content.size() <= 5000 &&
             (!('pdfTitle' in data) || (data.pdfTitle is string && data.pdfTitle.size() <= 150)) &&
             (!('pdfLocalFileName' in data) || (data.pdfLocalFileName is string && data.pdfLocalFileName.size() <= 200)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPersonalNote(data, userId) {
      return data.userId is string && data.userId == userId &&
             (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128)) &&
             (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 100)) &&
             (!('topicName' in data) || (data.topicName is string && data.topicName.size() <= 120)) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             (!('contentSummary' in data) || (data.contentSummary is string && data.contentSummary.size() <= 500)) &&
             data.blocksJson is string && data.blocksJson.size() <= 350000 &&
             data.updatedAtMillis is int && data.updatedAtMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPdfAnnotation(data, userId) {
      return data.userId is string && data.userId == userId &&
             isValidId(data.noteId) &&
             data.annotationsJson is string && data.annotationsJson.size() <= 600000 &&
             data.updatedAtMillis is int && data.updatedAtMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBookmark(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.bookmarkType in ['IMPORTANT_QUESTION', 'WRONG_QUESTION', 'FAVORITE_NOTE', 'SAVED_TOPIC', 'PDF_PAGE'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 300)) &&
             (!('refId' in data) || (data.refId is string && data.refId.size() <= 128)) &&
             (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128)) &&
             (!('topicId' in data) || (data.topicId is string && data.topicId.size() <= 128)) &&
             (!('subtopicId' in data) || (data.subtopicId is string && data.subtopicId.size() <= 128)) &&
             (!('pageIndex' in data) || (data.pageIndex is int && data.pageIndex >= 0)) &&
             (!('questionJson' in data) || (data.questionJson is string && data.questionJson.size() <= 10000)) &&
             data.createdAtMillis is int && data.createdAtMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFullLengthExam(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 200)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /appConfig/support {
      allow get: if isSignedIn();
      allow create, update: if isAdmin() &&
                               incoming().keys().hasAll(['whatsappDigits', 'updatedAt']) &&
                               incoming().keys().hasOnly(['whatsappDigits', 'updatedAt']) &&
                               incoming().whatsappDigits is string &&
                               incoming().whatsappDigits.size() >= 10 &&
                               incoming().whatsappDigits.size() <= 20 &&
                               incoming().updatedAt is timestamp &&
                               incoming().updatedAt <= request.time;
      allow delete: if false;
    }

    // Shared Educational Catalog (Admin uploads once -> All Students read published items)
    match /sharedSubjects/{subjectId} {
      allow get: if (isSignedIn() && existing().published == true) || isAdmin();
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(subjectId) &&
                               incoming().nameEn is string && incoming().nameEn.size() >= 1 && incoming().nameEn.size() <= 80 &&
                               incoming().published is bool &&
                               incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow delete: if isAdmin();
    }

    match /sharedTopics/{topicId} {
      allow get: if (isSignedIn() && existing().published == true) || isAdmin();
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(topicId) &&
                               isValidId(incoming().subjectId) &&
                               incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 120 &&
                               incoming().published is bool &&
                               incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow delete: if isAdmin();
    }

    match /sharedSubtopics/{subtopicId} {
      allow get: if (isSignedIn() && existing().published == true) || isAdmin();
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(subtopicId) &&
                               isValidId(incoming().subjectId) &&
                               isValidId(incoming().topicId) &&
                               incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 120 &&
                               incoming().published is bool &&
                               incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow delete: if isAdmin();
    }

    match /sharedContent/{contentId} {
      allow get: if (isSignedIn() && existing().published == true) || isAdmin();
      allow list: if isSignedIn();
      allow create: if isAdmin() && isValidId(contentId) &&
                       isValidId(incoming().subjectId) &&
                       isValidId(incoming().topicId) &&
                       isValidId(incoming().subtopicId) &&
                       incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 150 &&
                       incoming().noteType in ['PDF', 'HTML', 'IMAGE', 'FOLDER'] &&
                       incoming().version is int && incoming().version >= 1 &&
                       incoming().published is bool &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow update: if (isAdmin() &&
                        incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 150 &&
                        incoming().published is bool &&
                        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time) ||
                       (isSignedIn() &&
                        existing().published == true &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['downloadsCount', 'updatedAt']) &&
                        incoming().downloadsCount is int &&
                        incoming().downloadsCount == existing().downloadsCount + 1 &&
                        incoming().updatedAt is timestamp && incoming().updatedAt <= request.time);
      allow delete: if isAdmin();
    }

    match /sharedVideos/{videoId} {
      allow get: if (isSignedIn() && existing().published == true) || isAdmin();
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(videoId) &&
                               isValidId(incoming().subjectId) &&
                               isValidId(incoming().topicId) &&
                               isValidId(incoming().subtopicId) &&
                               incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 150 &&
                               incoming().youtubeUrl is string && incoming().youtubeUrl.size() >= 1 && incoming().youtubeUrl.size() <= 500 &&
                               incoming().published is bool &&
                               incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow delete: if isAdmin();
    }

    match /sharedMcqs/{mcqId} {
      allow get: if (isSignedIn() && existing().published == true) || isAdmin();
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(mcqId) &&
                               isValidId(incoming().subjectId) &&
                               isValidId(incoming().topicId) &&
                               isValidId(incoming().subtopicId) &&
                               incoming().question is string && incoming().question.size() >= 1 && incoming().question.size() <= 500 &&
                               incoming().options is list && incoming().options.size() >= 2 && incoming().options.size() <= 6 &&
                               incoming().correctIndex is int && incoming().correctIndex >= 0 && incoming().correctIndex < incoming().options.size() &&
                               incoming().published is bool &&
                               incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow delete: if isAdmin();
    }

    match /sharedFullLengthExams/{examId} {
      allow get: if (isSignedIn() && existing().published == true) || isAdmin();
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(examId) &&
                               incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 120 &&
                               (!('subtitle' in incoming()) || (incoming().subtitle is string && incoming().subtitle.size() <= 200)) &&
                               incoming().published is bool &&
                               incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow delete: if isAdmin();
    }

    // Student summaries for Admin Analytics Dashboard
    match /studentSummaries/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) &&
                               incoming().userId == userId &&
                               incoming().displayName is string && incoming().displayName.size() >= 1 && incoming().displayName.size() <= 100 &&
                               incoming().downloadsCount is int && incoming().downloadsCount >= 0 &&
                               incoming().testAttemptsCount is int && incoming().testAttemptsCount >= 0 &&
                               incoming().averageScorePct is number && incoming().averageScorePct >= 0 && incoming().averageScorePct <= 100 &&
                               incoming().lastActiveMillis is int && incoming().lastActiveMillis >= 0 &&
                               incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow delete: if isAdmin();
    }

    // Student WhatsApp material/test requests tracked for Admin
    match /whatsappRequests/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(requestId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().studentName is string && incoming().studentName.size() >= 1 && incoming().studentName.size() <= 100 &&
                       incoming().requestType is string && incoming().requestType.size() >= 1 && incoming().requestType.size() <= 80 &&
                       incoming().subject is string && incoming().subject.size() >= 1 && incoming().subject.size() <= 100 &&
                       incoming().status in ['PENDING', 'FULFILLED', 'REPLIED'] &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow update: if isAdmin() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       incoming().status in ['PENDING', 'FULFILLED', 'REPLIED'] &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'role', 'examName', 'examDateMillis', 'themeId', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);
      allow update: if isSignedIn() &&
                       isValidUserProfile(incoming(), userId) &&
                       isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'role', 'examName', 'examDateMillis', 'themeId', 'updatedAt']);
      allow delete: if isOwner(userId);

      match /subjects/{subjectId} {
        allow get: if isOwner(userId) && isValidId(subjectId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(subjectId) &&
                         incoming().keys().hasAll(['userId', 'nameEn', 'iconKey', 'colorHex', 'sortOrder', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'nameEn', 'nameHi', 'iconKey', 'colorHex', 'sortOrder', 'createdAt', 'updatedAt']) &&
                         isValidSubject(incoming(), userId);
        allow update: if isSignedIn() &&
                         isValidSubject(incoming(), userId) &&
                         isOwner(userId) && isValidId(subjectId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['nameEn', 'nameHi', 'iconKey', 'colorHex', 'sortOrder', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(subjectId);
      }

      match /topics/{topicId} {
        allow get: if isOwner(userId) && isValidId(topicId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(topicId) &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'name', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'name', 'description', 'createdAt', 'updatedAt']) &&
                         isValidTopic(incoming(), userId);
        allow update: if isSignedIn() &&
                         isValidTopic(incoming(), userId) &&
                         isOwner(userId) && isValidId(topicId) &&
                         incoming().userId == existing().userId &&
                         incoming().subjectId == existing().subjectId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(topicId);
      }

      match /subtopics/{subtopicId} {
        allow get: if isOwner(userId) && isValidId(subtopicId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(subtopicId) &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'topicId', 'name', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'topicId', 'name', 'lastStudiedDate', 'createdAt', 'updatedAt']) &&
                         isValidSubtopic(incoming(), userId);
        allow update: if isSignedIn() &&
                         isValidSubtopic(incoming(), userId) &&
                         isOwner(userId) && isValidId(subtopicId) &&
                         incoming().userId == existing().userId &&
                         incoming().subjectId == existing().subjectId &&
                         incoming().topicId == existing().topicId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'lastStudiedDate', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(subtopicId);
      }

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'topicId', 'subtopicId', 'folderName', 'title', 'noteType', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'topicId', 'subtopicId', 'folderName', 'title', 'noteType', 'localFileName', 'htmlContent', 'lastOpenedDate', 'isMockTest', 'createdAt', 'updatedAt']) &&
                         isValidNote(incoming(), userId);
        allow update: if isSignedIn() &&
                         isValidNote(incoming(), userId) &&
                         isOwner(userId) && isValidId(noteId) &&
                         incoming().userId == existing().userId &&
                         incoming().subjectId == existing().subjectId &&
                         incoming().topicId == existing().topicId &&
                         incoming().subtopicId == existing().subtopicId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['folderName', 'title', 'localFileName', 'htmlContent', 'lastOpenedDate', 'isMockTest', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      match /videos/{videoId} {
        allow get: if isOwner(userId) && isValidId(videoId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(videoId) &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'topicId', 'subtopicId', 'title', 'youtubeUrl', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'topicId', 'subtopicId', 'title', 'youtubeUrl', 'channelOrNote', 'lastWatchedDate', 'createdAt', 'updatedAt']) &&
                         isValidVideo(incoming(), userId);
        allow update: if isSignedIn() &&
                         isValidVideo(incoming(), userId) &&
                         isOwner(userId) && isValidId(videoId) &&
                         incoming().userId == existing().userId &&
                         incoming().subjectId == existing().subjectId &&
                         incoming().topicId == existing().topicId &&
                         incoming().subtopicId == existing().subtopicId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'youtubeUrl', 'channelOrNote', 'lastWatchedDate', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(videoId);
      }

      match /mcqs/{mcqId} {
        allow get: if isOwner(userId) && isValidId(mcqId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(mcqId) &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'topicId', 'subtopicId', 'question', 'options', 'correctIndex', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'topicId', 'subtopicId', 'question', 'options', 'correctIndex', 'explanation', 'createdAt', 'updatedAt']) &&
                         isValidMcq(incoming(), userId);
        allow update: if isSignedIn() &&
                         isValidMcq(incoming(), userId) &&
                         isOwner(userId) && isValidId(mcqId) &&
                         incoming().userId == existing().userId &&
                         incoming().subjectId == existing().subjectId &&
                         incoming().topicId == existing().topicId &&
                         incoming().subtopicId == existing().subtopicId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['question', 'options', 'correctIndex', 'explanation', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(mcqId);
      }

      match /testResults/{resultId} {
