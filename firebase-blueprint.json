{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, email, photo, exam countdown settings, and preferred theme.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "role": { "type": "string" },
        "examName": { "type": "string" },
        "examDateMillis": { "type": "integer" },
        "themeId": {
          "type": "string",
          "enum": ["bunts_royal_light", "bunts_navy_dark", "midnight_teal", "forest_sage", "indigo_velvet", "warm_espresso"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "createdAt", "updatedAt"]
    },
    "SharedContentItem": {
      "title": "SharedContentItem",
      "description": "Admin-uploaded PDF/HTML/Image shared across all students with Firebase Storage path and version.",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "topicId": { "type": "string" },
        "subtopicId": { "type": "string" },
        "folderName": { "type": "string" },
        "title": { "type": "string" },
        "noteType": { "type": "string", "enum": ["PDF", "HTML", "IMAGE", "FOLDER"] },
        "localFileName": { "type": "string" },
        "storagePath": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "htmlContent": { "type": "string" },
        "version": { "type": "integer" },
        "published": { "type": "boolean" },
        "isMockTest": { "type": "boolean" },
        "downloadsCount": { "type": "integer" },
        "fileSizeBytes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectId", "topicId", "subtopicId", "folderName", "title", "noteType", "version", "published", "createdAt", "updatedAt"]
    },
    "PersonalNote": {
      "title": "PersonalNote",
      "description": "Student rich-text personal note with headings, checklists, tables, highlights, and images.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "topicName": { "type": "string" },
        "title": { "type": "string" },
        "contentSummary": { "type": "string" },
        "blocksJson": { "type": "string" },
        "updatedAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "blocksJson", "updatedAtMillis", "createdAt", "updatedAt"]
    },
    "PdfAnnotationDoc": {
      "title": "PdfAnnotationDoc",
      "description": "Per-student PDF digital pen strokes, highlights, shapes, and text boxes.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "noteId": { "type": "string" },
        "annotationsJson": { "type": "string" },
        "updatedAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "noteId", "annotationsJson", "updatedAtMillis", "createdAt", "updatedAt"]
    },
    "BookmarkItem": {
      "title": "BookmarkItem",
      "description": "Student bookmark for important/wrong questions, notes, topics, or PDF pages.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "bookmarkType": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "refId": { "type": "string" },
        "subjectId": { "type": "string" },
        "topicId": { "type": "string" },
        "subtopicId": { "type": "string" },
        "pageIndex": { "type": "integer" },
        "questionJson": { "type": "string" },
        "createdAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bookmarkType", "title", "createdAtMillis", "createdAt", "updatedAt"]
    },
    "WhatsAppRequestRecord": {
      "title": "WhatsAppRequestRecord",
      "description": "Student material/test request record visible to the Admin for tracking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "requestType": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "subtopic": { "type": "string" },
        "extraMessage": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "studentName", "requestType", "subject", "status", "createdAt", "updatedAt"]
    },
    "StudentSummary": {
      "title": "StudentSummary",
      "description": "Student summary metrics for Admin Analytics dashboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "downloadsCount": { "type": "integer" },
        "testAttemptsCount": { "type": "integer" },
        "averageScorePct": { "type": "number" },
        "lastActiveMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "downloadsCount", "testAttemptsCount", "averageScorePct", "lastActiveMillis", "createdAt", "updatedAt"]
    },
    "FullLengthExam": {
      "title": "FullLengthExam",
      "description": "Exam category for full-length HTML mock tests created by students or shared by admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" } },
    "/users/{userId}/personalNotes/{noteId}": { "schema": { "$ref": "#/entities/PersonalNote" } },
    "/users/{userId}/pdfAnnotations/{docId}": { "schema": { "$ref": "#/entities/PdfAnnotationDoc" } },
    "/users/{userId}/bookmarks/{bookmarkId}": { "schema": { "$ref": "#/entities/BookmarkItem" } },
    "/users/{userId}/fullLengthExams/{examId}": { "schema": { "$ref": "#/entities/FullLengthExam" } },
    "/sharedFullLengthExams/{examId}": { "schema": { "$ref": "#/entities/FullLengthExam" } },
    "/sharedContent/{contentId}": { "schema": { "$ref": "#/entities/SharedContentItem" } },
    "/whatsappRequests/{requestId}": { "schema": { "$ref": "#/entities/WhatsAppRequestRecord" } },
    "/studentSummaries/{userId}": { "schema": { "$ref": "#/entities/StudentSummary" } }
  }
}
